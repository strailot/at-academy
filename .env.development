# Application (development)
NEXTAUTH_URL=http://localhost:3000
# Local-only secret. Generate your own: openssl rand -base64 32
NEXTAUTH_SECRET=dev-secret-not-for-production

# Database — this project ships with an in-memory Prisma-compatible store
# (see src/lib/prisma.ts), so no live database is required to run or build.
# Point this at your own database only if you wire up a real Prisma client.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/postgres"

# Payment (disabled in dev)
NEXT_PUBLIC_ENABLE_PAYMENTS=false
NEXT_PUBLIC_ENABLE_LIVE_CLASSES=false
