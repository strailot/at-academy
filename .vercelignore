# Vercel builds this project from the linked GitHub repository, so this file
# only trims what a CLI upload would otherwise send. Keep it minimal and
# explicit — overly broad patterns can starve the build of source files.

node_modules
.next
out
build
coverage

# Real secrets never get deployed as files; production values are configured
# as Vercel Environment Variables instead.
.env
.env.local
.env.development.local
.env.production.local
.env.test.local

# Local tooling state
.vercel
.netlify
.playwright-mcp
supabase/.temp

# Large print-format design exports, not served at runtime
Logo
